# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_DATABASE=ai_chat
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# ── Backend ───────────────────────────────────────────────────────────────────
SERVER_PORT=9600

# JWT — use a cryptographically random string of at least 32 characters
JWT_SECRET=replace_with_secure_secret_minimum_32_chars
JWT_EXPIRATION_MS=3600000

# ── LLM Provider (OpenAI-compatible) ─────────────────────────────────────────
# For Groq (free): https://console.groq.com
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# For OpenAI: uncomment below and comment out Groq lines above
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Frontend (local dev only — Docker uses /api proxy) ───────────────────────
VITE_API_BASE_URL=http://localhost:9600/api
